# Web service listen port
PORT=3000

# Target LibreOJ site
LOJ_BASE_URL=https://loj.ac

# Optional: mount the app under a path such as /loj-download
APP_BASE_PATH=

# Optional: login cookie for private or login-only problems
LOJ_COOKIE=

# Persistent storage directory for jobs, archives and temporary workspace
STORAGE_DIR=/srv/loj-download-web/storage

# Parallel job workers
JOB_CONCURRENCY=2

# Shared file download concurrency
DOWNLOAD_CONCURRENCY=5

# How long completed and failed jobs should be kept
JOB_RETENTION_HOURS=24
