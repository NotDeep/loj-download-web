{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibreOJ 题目包下载器",
  "version": "1.0.1",
  "identifier": "dev.hydro.loj-download.desktop",
  "build": {
    "beforeBuildCommand": "yarn prepare:tauri",
    "beforeDevCommand": "yarn prepare:tauri",
    "frontendDist": "../public"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/loj-download-node"
    ],
    "resources": [
      "../dist/**/*"
    ]
  }
}
