{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "desktop/**/*.ts",
    "index.ts",
    "server.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src-tauri",
    "storage",
    "storage-test",
    "storage-test-limit"
  ]
}
